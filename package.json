{
  "name": "grid-app",
  "version": "0.0.0",
  "description": "Development workspace for @inandu-solutions/grid-angular — the library lives in projects/inandu-grid, the demo app in src/.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inandusolutions/inandu-grid.git"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng build inandu-grid && ng serve",
    "build": "npm run build:lib && ng build",
    "build:lib": "ng build inandu-grid && npm run build:schematics",
    "build:schematics": "node projects/inandu-grid/schematics/build.mjs",
    "test:schematics": "npm run build:schematics && tsc -p projects/inandu-grid/schematics/tsconfig.spec.json && node --test out-tsc/schematics-spec/**/*.spec.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test grid-app",
    "test:lib": "ng test inandu-grid",
    "e2e": "playwright test --project=chromium",
    "lint": "ng lint",
    "gifs:record": "playwright test --project=promo",
    "gifs": "npm run gifs:record && node scripts/make-gifs.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-browser-dynamic": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@ngx-translate/core": "^18.0.0",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~6.0.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.10.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "karma-safari-launcher": "^1.0.0",
    "less": "^4.9.1",
    "ng-packagr": "^22.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0"
  }
}